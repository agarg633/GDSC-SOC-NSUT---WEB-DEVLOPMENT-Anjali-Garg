import webbrowser
from urllib.parse import urlparse
from urllib.request import Request, urlopen
from urllib.error import URLError, HTTPError
print("*********************************This program is created for GDSC NSUT WEB DEVLOPMENT******************************** ")
def validate_url(url, shorturl):

    if len(url) <= len(shorturl):
        print("Invalid URL: URL must be longer than the short URL.")
        return False

    invalid_characters = [" ", "<", ">", '"', "'", "{", "}", "|", "\\", "^", "`"]

    for char in invalid_characters:
        if char in url:
            print("Invalid URL: URL contains an invalid character:", char)
            return False

    check_url = url

    if not (url.startswith("http://") or url.startswith("https://")):
        check_url = "https://" + url

    parsed_url = urlparse(check_url)

    if not parsed_url.netloc:
        print("Invalid URL: Please enter a valid website URL.")
        return False

    if "." not in parsed_url.netloc:
        print("Invalid URL: Please enter a valid website URL.")
        return False

    try:
        request = Request(
            check_url,
            headers={"User-Agent": "Mozilla/5.0"}
        )

        response = urlopen(request, timeout=5)

        print("Website exists and is reachable.")
        response.close()

    except HTTPError as e:

        if e.code in [401, 403, 404]:
            print("Website exists, but returned HTTP error:", e.code)
        else:
            print("Website could not be verified.")
            return False

    except URLError:
        print("Invalid URL: Website does not exist or cannot be reached.")
        return False

    except Exception:
        print("Invalid URL: Could not verify the website.")
        return False

    return True


def find_existing_url(url):

    try:

        file = open("fileurl_a.txt", "r")

        for line in file:

            data = line.strip().split("----------->")

            if len(data) == 2:

                saved_shorturl = data[0]
                saved_longurl = data[1]

                if saved_longurl.lower() == url.lower():

                    file.close()
                    return saved_shorturl

        file.close()

    except FileNotFoundError:
        return None

    return None


